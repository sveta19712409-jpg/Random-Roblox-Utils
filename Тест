-- ЧАСТЬ 2: КОНФИГУРАЦИЯ
local Config = {
    MinSwingDelay = 0.40,
    MaxSwingDelay = 0.75,
    MinRetryDelay = 2.5,
    MaxRetryDelay = 5.0,
    MissionMinTime = 30,
    MaxHitsPerSecond = 2,
    RefillCooldown = 6,
    NoHitTimeout = 2.5,
}

local KnownRemotes = {
    Swing  = "SwingEvent",
    Retry  = "RetryEvent",
    Escape = "EscapeEvent",
    Refill = "RefillEvent",
}

local function getRemote(name)
    local r = ReplicatedStorage:FindFirstChild(name, true)
    if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
        return r
    end
    return nil
end

local function jitter(min, max)
    return min + math.random() * (max - min)
end

-- ЧАСТЬ 3: ПРОВЕРКА БАНА
local function checkShadowBan()
    local ok, res = pcall(function()
        return Players:GetPlayerByUserId(LocalPlayer.UserId)
    end)
    return not (ok and res)
end

-- ЧАСТЬ 4: ТАЙМЕР
local missionStartTime = tick()
local function startMissionTimer() missionStartTime = tick() end
local function isMissionSafeToLeave()
    return (tick() - missionStartTime) >= Config.MissionMinTime
end

-- ЧАСТЬ 5: АВТО-УДАР
local autoSwingEnabled = false
local lastSwingTime = 0
local swingCount = 0
local secondStart = tick()
local lastHitMark = tick()
local function markHit() lastHitMark = tick() end

task.spawn(function()
    while true do
        if autoSwingEnabled then
            local now = tick()
            if now - lastSwingTime >= jitter(Config.MinSwingDelay, Config.MaxSwingDelay) then
                if now - secondStart >= 1 then
                    swingCount = 0
                    secondStart = now
                end
                if swingCount < Config.MaxHitsPerSecond then
                    local r = getRemote(KnownRemotes.Swing)
                    if r then
                        pcall(function()
                            if r:IsA("RemoteEvent") then r:FireServer()
                            else r:InvokeServer() end
                        end)
                        markHit()
                    end
                    swingCount = swingCount + 1
                    lastSwingTime = now
                end
            end
        end
        task.wait(0.05)
    end
end)

-- ЧАСТЬ 6: АВТО-ПОВТОР
local autoRetryEnabled = false

task.spawn(function()
    while true do
        if autoRetryEnabled and isMissionSafeToLeave() then
            local r = getRemote(KnownRemotes.Retry)
            if r then
                pcall(function()
                    if r:IsA("RemoteEvent") then r:FireServer()
                    else r:InvokeServer() end
                end)
            end
            task.wait(jitter(Config.MinRetryDelay, Config.MaxRetryDelay))
        else
            task.wait(0.5)
        end
    end
end)

-- ЧАСТЬ 7: АВТО-ПОПОЛНЕНИЕ КЛИНКОВ
local autoRefillEnabled = true
local lastRefillAttempt = 0

task.spawn(function()
    while true do
        if autoRefillEnabled and autoSwingEnabled then
            local idle = tick() - lastHitMark
            local sinceRefill = tick() - lastRefillAttempt
            if idle > Config.NoHitTimeout and sinceRefill > Config.RefillCooldown then
                local r = getRemote(KnownRemotes.Refill)
                if r then
                    pcall(function()
                        if r:IsA("RemoteEvent") then r:FireServer()
                        else r:InvokeServer() end
                    end)
                    lastRefillAttempt = tick()
                    markHit()
                end
            end
        end
        task.wait(0.5)
    end
end)

