    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = isTouch and 14 or 13
    btn.Text = text .. "  [ВЫКЛ]"
    btn.Parent = panel
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = text .. (enabled and "  [ВКЛ]" or "  [ВЫКЛ]")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 110, 50) or Color3.fromRGB(40, 40, 40)
        callback(enabled)
    end)
end

